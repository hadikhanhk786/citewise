# AI Service Config
PORT=8000
LOG_LEVEL=info

# Database (Same as Node backend but with async drier if needed, though psycopg 3 supports sync/async)
# For SQLAlchemy async: postgresql+psycopg://user:pass@host:5432/db
DATABASE_URL=postgresql+psycopg://hahikhan@postgres:5432/copilot

# AI Providers
# Options: openai, gemini
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-3.5-turbo
OPENAI_EMBED_MODEL=text-embedding-3-small

# Gemini
GEMINI_API_KEY=AI...
GEMINI_CHAT_MODEL=gemini-pro
GEMINI_EMBED_MODEL=models/embedding-001
